# ==============================================================================
# Environment Configuration Template
# Copy this file to .env and fill in the values.
# ==============================================================================

# ------------------------------------------------------------------------------
# Neon Database Connections (Prisma 7 Two-Tier Architecture)
# ------------------------------------------------------------------------------
# 1. DATABASE_URL: Neon Pooled Connection String (port 5432 with -pooler host)
#    Used strictly by application runtime in src/lib/prisma.ts via @prisma/adapter-pg
DATABASE_URL="postgresql://[user]:[password]@[endpoint]-pooler.[region].neon.tech/[dbname]?sslmode=require"

# 2. DIRECT_URL: Neon Direct Connection String (port 5432 without -pooler host)
#    Required exclusively by Prisma CLI in prisma7.config.ts for DDL migrations and schema engine
DIRECT_URL="postgresql://[user]:[password]@[endpoint].[region].neon.tech/[dbname]?sslmode=require"

# ------------------------------------------------------------------------------
# Better Auth Configuration
# ------------------------------------------------------------------------------
BETTER_AUTH_SECRET="replace-with-a-secure-random-32-byte-base64-secret"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# Google OAuth Configuration (Optional in local development)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
